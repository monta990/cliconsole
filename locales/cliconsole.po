msgstr ""
"Project-Id-Version: CLI Console 1.0.0\n"
"Language: es_MX\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid "CLI Console"
msgstr "Consola CLI"
msgid "CLI Console configuration"
msgstr "Configuración de Consola CLI"
msgid "Run GLPI bin/console commands without shell access."
msgstr "Ejecuta comandos de bin/console de GLPI sin acceso a la terminal."
msgid "Only GLPI console commands are accepted. The selected command is always executed against this GLPI instance's bin/console."
msgstr "Solo se aceptan comandos de consola de GLPI. El comando seleccionado siempre se ejecuta contra el bin/console de esta instalación de GLPI."
msgid "Terminal"
msgstr "Terminal"
msgid "Run"
msgstr "Ejecutar"
msgid "Clear"
msgstr "Limpiar"
msgid "Ready"
msgstr "Listo"
msgid "Running..."
msgstr "Ejecutando..."
msgid "Running command..."
msgstr "Ejecutando comando..."
msgid "Process finished."
msgstr "Proceso terminado."
msgid "The command failed to start or the connection was interrupted."
msgstr "El comando no pudo iniciarse o la conexión fue interrumpida."
msgid "The browser does not support streamed responses."
msgstr "El navegador no admite respuestas transmitidas en tiempo real."
msgid "Examples: migration:timestamps, cache:clear, list, help migration:timestamps"
msgstr "Ejemplos: migration:timestamps, cache:clear, list, help migration:timestamps"
msgid "PHP CLI binary path"
msgstr "Ruta del ejecutable PHP CLI"
msgid "Choose which PHP CLI executable GLPI should use for bin/console."
msgstr "Elige qué ejecutable PHP CLI debe usar GLPI para bin/console."
msgid "Enter an absolute path such as /usr/bin/php85. The executable must exist and be executable by the web server account."
msgstr "Introduce una ruta absoluta, como /usr/bin/php85. El ejecutable debe existir y poder ser ejecutado por la cuenta del servidor web."
msgid "The configured PHP binary is used only with this GLPI instance's real bin/console. The command text is never passed through a shell."
msgstr "El ejecutable PHP configurado solo se utiliza con el bin/console real de esta instalación de GLPI. El texto del comando nunca se pasa por un shell."
msgid "The configured PHP binary is used only with this GLPI instance's real bin/console. The command text is never passed through a shell."
msgstr "El ejecutable PHP configurado solo se utiliza con el bin/console real de esta instalación de GLPI. El texto del comando nunca se pasa por un shell."
msgid "Save"
msgstr "Guardar"
msgid "Cancel"
msgstr "Cancelar"
msgid "Configure"
msgstr "Configurar"
msgid "Configure PHP CLI"
msgstr "Configurar PHP CLI"
msgid "Not configured"
msgstr "No configurado"
msgid "Configure the PHP CLI binary path before using the console."
msgstr "Configura la ruta del ejecutable PHP CLI antes de utilizar la consola."
msgid "Execution settings"
msgstr "Configuración de ejecución"
msgid "Execution boundary"
msgstr "Límite de ejecución"
msgid "CLI Console always invokes the real bin/console located under this GLPI installation. The configured PHP binary cannot be used to execute another script through this interface, and the command is not passed through a shell."
msgstr "CLI Console siempre invoca el bin/console real ubicado dentro de esta instalación de GLPI. El ejecutable PHP configurado no puede utilizarse para ejecutar otro script mediante esta interfaz y el comando no se pasa por un shell."
msgid "Back to console"
msgstr "Volver a la consola"
msgid "Allows this profile to open the console and execute GLPI bin/console commands."
msgstr "Permite a este perfil abrir la consola y ejecutar comandos de bin/console de GLPI."
msgid "Enter an absolute path to the PHP CLI executable."
msgstr "Introduce una ruta absoluta al ejecutable PHP CLI."
msgid "The configured PHP CLI binary does not exist or is not executable."
msgstr "El ejecutable PHP CLI configurado no existe o no es ejecutable."
msgid "GLPI bin/console could not be found."
msgstr "No se encontró el bin/console de GLPI."
msgid "The detected bin/console is outside the GLPI root."
msgstr "El bin/console detectado está fuera de la raíz de GLPI."
msgid "Shell operators are not allowed. Enter only a GLPI console command and its arguments."
msgstr "No se permiten operadores del shell. Introduce únicamente un comando de consola de GLPI y sus argumentos."
msgid "The command could not be parsed."
msgstr "No se pudo interpretar el comando."
msgid "An empty or invalid argument was supplied."
msgstr "Se proporcionó un argumento vacío o no válido."
msgid "Re-authentication is required. Reload the console page and verify your identity again."
msgstr "Se requiere una nueva autenticación. Recarga la página de la consola y verifica tu identidad nuevamente."

msgid "No command was provided."
msgstr "No se proporcionó ningún comando."

msgid "GitHub version check"
msgstr "Comprobación de versión de GitHub"
msgid "Installed version"
msgstr "Versión instalada"
msgid "Check for updates"
msgstr "Buscar actualizaciones"
msgid "Repository"
msgstr "Repositorio"
msgid "Checking GitHub..."
msgstr "Comprobando GitHub..."
msgid "Version check completed."
msgstr "Comprobación de versión completada."
msgid "Unable to check the GitHub version."
msgstr "No se pudo comprobar la versión de GitHub."
msgid "Unable to contact GitHub right now."
msgstr "No se puede contactar con GitHub en este momento."
msgid "The GitHub project does not expose a readable plugin version yet."
msgstr "El proyecto de GitHub todavía no expone una versión de complemento legible."
msgid "Version %s is available on GitHub."
msgstr "La versión %s está disponible en GitHub."
msgid "You are running the latest version published on GitHub."
msgstr "Estás utilizando la última versión publicada en GitHub."
