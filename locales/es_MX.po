msgid ""
msgstr ""
"Project-Id-Version: CLI Console\n"
"Language: es_MX\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "An invalid argument was supplied."
msgstr "Se proporcionó un argumento no válido."

msgid "Back to console"
msgstr "Volver a la consola"

msgid "CLI Console"
msgstr "Consola CLI"

msgid "CLI Console always invokes the real bin/console located under this GLPI installation. The configured PHP binary cannot be used to execute another script through this interface, and the command is not passed through a shell."
msgstr "Consola CLI siempre invoca el bin/console real ubicado en esta instalación de GLPI. El ejecutable PHP configurado no puede utilizarse para ejecutar otro script desde esta interfaz y el comando no se pasa por un shell."

msgid "CLI Console configuration"
msgstr "Configuración de Consola CLI"

msgid "CLI Console configuration saved successfully."
msgstr "La configuración de CLI Console se guardó correctamente."

msgid "Cancel"
msgstr "Cancelar"

msgid "Check for updates"
msgstr "Buscar actualizaciones"

msgid "Choose which PHP CLI executable GLPI should use for bin/console."
msgstr "Elige qué ejecutable PHP CLI debe utilizar GLPI para bin/console."

msgid "Clear"
msgstr "Limpiar"

msgid "Completed"
msgstr "Completado"

msgid "Configure"
msgstr "Configurar"

msgid "Configure PHP CLI"
msgstr "Configurar PHP CLI"

msgid "Configure the PHP CLI executable before running commands."
msgstr "Configura el ejecutable PHP CLI antes de ejecutar comandos."

msgid "Enter a GLPI command..."
msgstr "Introduce un comando de GLPI..."

msgid "Enter an absolute path such as /usr/bin/php85. The executable must exist and be executable by the web server account."
msgstr "Enter an absolute path such as /usr/bin/php85. The executable must exist and be executable by the web server account."

msgid "Enter an absolute path to the PHP CLI executable."
msgstr "Introduce una ruta absoluta al ejecutable PHP CLI."

msgid "Error"
msgstr "Error"

msgid "Executable path"
msgstr "Ruta de ejecutable"

msgid "Execution boundary"
msgstr "Límite de ejecución"

msgid "Execution settings"
msgstr "Configuración de ejecución"

msgid "GLPI bin/console could not be found."
msgstr "No se encontró bin/console de GLPI."

msgid "GitHub version check"
msgstr "Comprobación de versión de GitHub"

msgid "Input sent to the running command."
msgstr "Entrada enviada al comando en ejecución."

msgid "Installed version"
msgstr "Versión instalada"

msgid "Interactive mode:"
msgstr "Modo interactivo:"

msgid "Invalid terminal session."
msgstr "Sesión de terminal no válida."

msgid "No command was provided."
msgstr "No se proporcionó ningún comando."

msgid "Only GLPI console commands are accepted. The command is always executed with this installation's real bin/console and is never passed through a shell."
msgstr "Solo se aceptan comandos de consola de GLPI. El comando siempre se ejecuta con el bin/console real de esta instalación y nunca se pasa por un shell."

msgid "PHP CLI binary path"
msgstr "Ruta del ejecutable PHP CLI"

msgid "PHP CLI not configured"
msgstr "PHP CLI no configurado"

msgid "Process finished successfully."
msgstr "Proceso terminado correctamente."

msgid "Process finished with errors."
msgstr "El proceso terminó con errores."

msgid "Process finished."
msgstr "Proceso terminado."

msgid "Process stopped."
msgstr "Proceso detenido."

msgid "Re-authentication is required. Reload the console page and verify your identity again."
msgstr "Se requiere una nueva autenticación. Recarga la página de la consola y verifica tu identidad nuevamente."

msgid "Ready"
msgstr "Listo"

msgid "Ready. Enter a GLPI console command."
msgstr "Listo. Introduce un comando de consola de GLPI."

msgid "Repository"
msgstr "Repositorio"

msgid "Restricted execution"
msgstr "Ejecución restringida"

msgid "Run"
msgstr "Ejecutar"

msgid "Run GLPI bin/console commands without shell access."
msgstr "Ejecuta comandos de bin/console de GLPI sin acceso a la terminal."

msgid "Running"
msgstr "Ejecutando"

msgid "Running... waiting for output or input."
msgstr "Ejecutando... esperando salida o entrada."

msgid "Save"
msgstr "Guardar"

msgid "Settings"
msgstr "Configuración"

msgid "Shell operators are not allowed. Enter only a GLPI console command and its arguments."
msgstr "No se permiten operadores del shell. Introduce únicamente un comando de consola de GLPI y sus argumentos."

msgid "Starting process..."
msgstr "Iniciando proceso..."

msgid "Stop"
msgstr "Detener"

msgid "Stopped"
msgstr "Detenido"

msgid "Stopping process..."
msgstr "Deteniendo el proceso..."

msgid "Terminal"
msgstr "Terminal"

msgid "Terminal session not found."
msgstr "No se encontró la sesión de terminal."

msgid "The GitHub project does not expose a readable plugin version yet."
msgstr "El proyecto de GitHub todavía no expone una versión de complemento legible."

msgid "The command could not be started."
msgstr "No se pudo iniciar el comando."

msgid "The configured PHP CLI binary does not exist or is not executable."
msgstr "El ejecutable PHP CLI configurado no existe o no es ejecutable."

msgid "The detected bin/console is outside the GLPI root."
msgstr "El bin/console detectado está fuera de la raíz de GLPI."

msgid "The terminal connection was interrupted."
msgstr "La conexión con la terminal fue interrumpida."

msgid "Unable to contact GitHub right now."
msgstr "No se puede contactar con GitHub en este momento."

msgid "Unable to create terminal session storage."
msgstr "No se pudo crear el almacenamiento de sesiones de terminal."

msgid "Unable to create the terminal session."
msgstr "No se pudo crear la sesión de terminal."

msgid "Unable to initialize the terminal session."
msgstr "No se pudo inicializar la sesión de terminal."

msgid "Unable to start the terminal worker."
msgstr "No se pudo iniciar el proceso de terminal."

msgid "Unsupported terminal action."
msgstr "Acción de terminal no compatible."

msgid "Version %s is available on GitHub."
msgstr "La versión %s está disponible en GitHub."

msgid "You are running the latest version published on GitHub."
msgstr "Estás utilizando la última versión publicada en GitHub."

msgid "commands can request input while they are running."
msgstr "Los comandos pueden solicitar datos mientras se están ejecutando."

msgid "You can consult the list of available GLPI console commands in the official documentation."
msgstr "Puedes consultar la lista de comandos de consola de GLPI disponibles en la documentación oficial."

msgid "View CLI documentation"
msgstr "Ver documentación de CLI"

msgid "CLI Console has an update available."
msgstr "CLI Console tiene una actualización disponible."

msgid "CLI Console is up to date."
msgstr "CLI Console está actualizado."

msgid "Latest stable version"
msgstr "Última versión estable"

msgid "View versions"
msgstr "Ver versiones"

msgid "CLI Console version could not be checked right now."
msgstr "No se pudo comprobar la versión de CLI Console en este momento."

msgid "Unable to create the CLI Console version cache directory."
msgstr "No se pudo crear el directorio de caché de versiones de CLI Console."

msgid "Only GLPI console commands are accepted. The command is always executed with this GLPI installation real bin/console and is never passed through a shell."
msgstr "Solo se aceptan comandos de consola de GLPI. El comando siempre se ejecuta con el bin/console real de esta instalación y nunca se pasa por un shell."
